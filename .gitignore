# Allowlist .gitignore: nothing is tracked unless a rule below re-includes
# it. A new kind of file is invisible to git until it is named here -- that
# is the point: generated output, editor droppings and machine-local state
# cannot arrive by accident.

# 1. Ignore everything ...
*

# 2. ... but still descend into directories, so the rules below can match
#    files nested inside them. Without this git prunes at the first level
#    and every `!` rule underneath is dead.
!*/

# 3. Repository metadata
!/.gitignore
!/README.md
!/CHANGELOG.md
!/ROADMAP.md
!/LICENSE.md
!/SECURITY.md

# 4. The package
#    One rule per directory level, no `**`: a new subdirectory stays
#    invisible until it is named here.
!/Project.toml
!/src/*.jl
!/ext/*.jl

# 5. Tests
!/test/*.jl

#    Vendored test font and its provenance. See test/fonts/README.md.
!/test/fonts/*.ttf
!/test/fonts/*.txt
!/test/fonts/*.md

# 6. Documentation sources
!/docs/Project.toml
!/docs/make.jl
!/docs/src/*.md
!/docs/src/api/*.md

# 7. Continuous integration, issue/PR templates, dependabot
!/.github/dependabot.yml
!/.github/workflows/*.yml

# 6. Never tracked, whatever the rules above say.
# Files generated by Pkg -- should not be committed for packages.
Manifest*.toml

# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# Local preferences
LocalPreferences.toml

# 7. Other
!justfile

# 8. Never tracked
.DS_Store
